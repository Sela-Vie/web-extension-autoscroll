{
    "manifest_version": 3,
    "name": "web-extension-autoscroll",
    "version": "1.0.1",
    "description": "an autoscroll extension for pinterest in the background",
    
    "action":{
        "default_popup":"index.html"
    },
    "permissions":[
        "scripting",
        "storage"
    ],
    "host_permissions":[
        "https://uk.pinterest.com/*"
    ]
}
